# UiPath Studio local state — machine-specific, never shared
.local/
.settings/
.project/
.entities/
.tmh/
.templates/
*.nuget.props
project.lock.json

# .objects/ is DELIBERATELY NOT IGNORED. It is the Object Repository — captured
# applications, screens and element descriptors. It is SOURCE, not local state.
#
# It used to be in the list above. A real project was found with 134 files under
# .objects/ (ObjectRepositoryScreenData / ObjectRepositoryTargetData, each .content
# holding the captured FullSelectorArgument) and ZERO of them tracked. A clone of that
# repo gets the workflows without any of the selectors, and the breakage looks like a
# selector problem rather than a source-control one.
#
# Do not re-add it as tidy-up. See
# .claude/skills/project-scaffolding/references/object-repository-and-git.md

# UiPath build output
.nuget/
packages/
*.nupkg

# Instantiated-in-place run artefacts. The templates ship empty Data/Output and
# Data/Temp on purpose; a real run's output must not be committed.
**/Data/Output/*
!**/Data/Output/.gitkeep
**/Data/Temp/*
!**/Data/Temp/.gitkeep

# Screenshots of a logged-in banking session contain customer data.
# See .claude/skills/security/references/prohibited-practices.md
**/Exceptions_Screenshots/*
!**/Exceptions_Screenshots/.gitkeep

# Credential and account fixtures. A test-data workbook or a scratch JSON holding sign-in
# details is NOT a credential source (see .claude/skills/standards/references/test-data.md);
# this is the backstop for when one gets created anyway.
test_data*.json
.env
.env.*

# Excel lock files
~$*.xlsx

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
