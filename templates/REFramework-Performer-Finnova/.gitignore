# UiPath Studio local state - machine-specific, never shared.
# fetch-template only copies templates/<name>/, so this file has to live inside the
# template: a project instantiated from it inherits nothing from the repo root.
.local/
.settings/
.objects/
.project/
.entities/
.tmh/
.templates/
*.nuget.props
project.lock.json

# UiPath build output
.nuget/
packages/
*.nupkg

# Run artefacts. The template ships these folders empty on purpose.
Data/Output/*
!Data/Output/.gitkeep
Data/Temp/*
!Data/Temp/.gitkeep

# Screenshots of a logged-in banking session contain customer data - this is a
# data-protection control, not tidiness.
# See .claude/skills/security/references/prohibited-practices.md
Exceptions_Screenshots/*
!Exceptions_Screenshots/.gitkeep

# Excel lock files
~$*.xlsx

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
