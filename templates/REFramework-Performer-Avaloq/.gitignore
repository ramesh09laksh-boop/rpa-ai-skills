# UiPath Studio local state - machine-specific, never shared.
# fetch-template only copies templates/<name>/, so this file has to live inside the
# template: a project instantiated from it inherits nothing from the repo root.
.local/
.settings/
.project/
.entities/
.tmh/
.templates/
*.nuget.props
project.lock.json

# .objects/ is DELIBERATELY NOT IGNORED. It is the Object Repository - captured
# applications, screens and element descriptors. It is SOURCE, not local state.
# A real project was found with 134 files under .objects/ and zero of them tracked:
# a clone got the workflows without any of the captured selectors. Do not re-add it.
# See the project-scaffolding skill, references/object-repository-and-git.md

# UiPath build output
.nuget/
packages/
*.nupkg

# Run artefacts. The template ships these folders empty on purpose.
Data/Output/*
!Data/Output/.gitkeep
Data/Temp/*
!Data/Temp/.gitkeep

# Screenshots of a logged-in banking session contain customer data - this is a
# data-protection control, not tidiness.
# See .claude/skills/security/references/prohibited-practices.md
Exceptions_Screenshots/*
!Exceptions_Screenshots/.gitkeep

# Credential and account fixtures. A test-data workbook or a scratch JSON holding sign-in
# details is NOT a credential source - credentials come from the Orchestrator asset named in
# the Assets sheet. This is the backstop for when one gets created anyway.
test_data*.json
.env
.env.*

# Excel lock files
~$*.xlsx

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
